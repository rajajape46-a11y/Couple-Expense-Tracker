# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API (or "Connect" → App Frameworks → Next.js).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon public" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Any long random string. Vercel sends it to /api/keepalive so only Vercel's
# daily job can call it. Set the same value in Vercel → Settings → Environment Variables.
CRON_SECRET=change-me-to-a-long-random-string
